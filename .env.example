# Copier ce fichier en .env.local (non versionné) et compléter.

# Source des données : mock (défaut) ou supabase
VITE_DATA_SOURCE=mock

# Supabase — clé publique anon uniquement (jamais la clé service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Webhooks n8n
VITE_N8N_WEBHOOK_ANALYSE_NOTE=
VITE_N8N_WEBHOOK_PREPARATION_RDV=
VITE_N8N_WEBHOOK_EXPORT_PDF=
