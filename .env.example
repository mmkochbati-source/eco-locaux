# Copier ce fichier en .env.local (non versionné) et compléter.

# Source des données : mock (défaut, données de démo) ou supabase
VITE_DATA_SOURCE=mock

# Supabase — clé publique anon uniquement (jamais la clé service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# n8n — URL = {BASE_URL}/{WEBHOOK_PREFIX}/eco-locaux/<chemin>
# Préfixe : webhook-test pendant les tests, webhook une fois les workflows publiés
VITE_N8N_BASE_URL=
VITE_N8N_WEBHOOK_PREFIX=webhook
